# Copie para .env e preencha. O .env NUNCA vai para o git.
# Em produção, envie o .env uma única vez por FTP para a raiz do FTP
# (mesmo nível da pasta public_html, nunca dentro dela).

APP_NAME=LiftEat
APP_ENV=local          # local | production
APP_DEBUG=true         # false em produção
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

# MySQL (dados em: Painel Locaweb > Hospedagem > Banco de Dados)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=lifteat
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
